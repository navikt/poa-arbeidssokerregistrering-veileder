{
    "name": "poa-arbeidssokerregistrering-veileder",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.28.6",
    "scripts": {
        "biome:migrate": "biome migrate --write",
        "dev": "next dev | pino-pretty",
        "build": "next build",
        "start": "next start",
        "lint": "biome check ./src",
        "lint:fix": "biome check --write ./src",
        "test": "vitest --run",
        "test:uu": "playwright test",
        "test:uu:helpers": "vitest --run --config vitest.uu.config.mts",
        "test:uu:ui": "playwright test --ui",
        "test:uu:report": "playwright show-report",
        "test:watch": "vitest",
        "test:ci": "vitest --run",
        "typecheck": "tsc ",
        "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm install --ignore-scripts",
        "prepare": "husky",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "2.13.0",
        "@navikt/aksel-icons": "8.21.0",
        "@navikt/arbeidssokerregisteret-utils": "3.0.1",
        "@navikt/ds-css": "8.21.0",
        "@navikt/ds-react": "8.21.0",
        "@navikt/ds-tailwind": "8.21.0",
        "@navikt/next-logger": "5.0.1",
        "@navikt/oasis": "4.2.2",
        "@unleash/nextjs": "1.6.7",
        "nanoid": "6.0.2",
        "next": "16.4.3",
        "pino": "10.4.0",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "2.6.4",
        "@playwright/test": "1.64.1",
        "@storybook/addon-docs": "10.6.5",
        "@storybook/addon-onboarding": "10.6.5",
        "@storybook/nextjs": "10.6.5",
        "@storybook/nextjs-vite": "10.6.5",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "husky": "9.1.7",
        "jsdom": "30.1.3",
        "knip": "6.44.1",
        "lint-staged": "17.6.0",
        "msw": "3.0.3",
        "msw-storybook-addon": "3.0.3",
        "pino-pretty": "13.2.0",
        "postcss": "8.5.32",
        "storybook": "10.6.5",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    },
    "lint-staged": {
        "src/app/**/*.{js,jsx,json,ts,tsx}": "biome check --write"
    },
    "engines": {
        "node": ">=26.13.1"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
